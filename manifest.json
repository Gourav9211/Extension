{
  "manifest_version": 3,
  "name": "Chess Position Analyst",
  "version": "0.5.0",
  "description": "Real-time chess analysis with local Stockfish engine, AI explanations, board highlights, and game archive.",
  "permissions": ["storage", "activeTab", "tabs", "downloads", "offscreen"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://tablebase.lichess.ovh/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Analyze chess position",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://chess.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine/*", "src/offscreen.html"],
      "matches": ["https://www.chess.com/*", "https://chess.com/*"]
    }
  ],
  "commands": {
    "toggle-analysis": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle live analysis"
    }
  },
  "options_page": "src/options.html"
  ,"options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
